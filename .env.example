# AWS Configuration for Deployment
# Copy this file to .env and fill in your values if needed
# Note: These are optional - you can also set them in your shell

# AWS Region (default: us-east-1)
AWS_REGION=us-east-1

# AWS Profile (optional - use if you have multiple AWS profiles)
# AWS_PROFILE=default

# Project Name (used for resource naming)
# PROJECT_NAME=secret-santa-app
